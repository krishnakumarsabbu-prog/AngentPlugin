{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "NFR Finding",
  "description": "An individual finding from a specialist assessment, with severity, evidence, and validation state.",
  "type": "object",
  "required": [
    "finding_id",
    "assessment_id",
    "requirement_id",
    "domain",
    "title",
    "description",
    "severity",
    "business_impact",
    "technical_impact",
    "expected_result",
    "observed_result",
    "evidence",
    "validation_method",
    "validation_state",
    "confidence",
    "status",
    "remediation",
    "owner",
    "due_date"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique identifier for this finding."
    },
    "assessment_id": {
      "type": "string",
      "description": "Links to the assessment."
    },
    "requirement_id": {
      "type": "string",
      "description": "Links to the requirement this finding assesses."
    },
    "domain": {
      "type": "string",
      "enum": [
        "performance",
        "scalability",
        "availability",
        "reliability",
        "security",
        "maintainability",
        "usability",
        "compatibility",
        "observability",
        "disaster-recovery",
        "portability",
        "compliance-privacy",
        "operability",
        "accessibility",
        "cost-efficiency",
        "ai-system-quality"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
    },
    "business_impact": {
      "type": "string"
    },
    "technical_impact": {
      "type": "string"
    },
    "expected_result": {
      "type": "string",
      "description": "What the requirement expects."
    },
    "observed_result": {
      "type": "string",
      "description": "What was actually observed."
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object" },
      "description": "References to evidence artifacts."
    },
    "validation_method": {
      "type": "string",
      "description": "How the finding was validated."
    },
    "tool": {
      "type": "string",
      "description": "Tool used (if any)."
    },
    "environment": {
      "type": "string",
      "description": "Environment where the check was performed."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "validation_state": {
      "type": "string",
      "enum": [
        "VERIFIED_PASS",
        "VERIFIED_FAIL",
        "PARTIALLY_VERIFIED",
        "NOT_TESTED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_APPLICABLE"
      ]
    },
    "na_justification": {
      "type": "string",
      "description": "Required when validation_state is NOT_APPLICABLE."
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "IN_REMEDIATION", "RESOLVED", "ACCEPTED_RISK", "WAIVED"]
    },
    "remediation": {
      "type": "string",
      "description": "Recommended remediation action."
    },
    "owner": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
